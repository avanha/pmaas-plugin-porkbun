<div class="entity-dns-record">
    <div class="name">{{.Name | html}} ({{.Type | html}})</div>
    {{if eq .Value ""}}
        <div class="record-value monospace unknown">Waiting for update</div>
    {{else}}
        <div class="record-value-line" {{if .ResolveSupported}}title="Looked up through {{if eq .Resolver ""}}this machine's resolver{{else}}{{.Resolver | html}}{{end}}"{{end}}>
            <span class="record-value monospace">{{.Value | html}}</span>
            {{if and .ResolveSupported .ResolveChecked}}
                {{if .ResolveMatches}}
                    <span class="resolve-mark resolve-ok" role="img" aria-label="resolves to the record's value">&#10003;</span>
                {{else}}
                    <span class="resolve-mark resolve-bad" role="img" aria-label="does not resolve to the record's value">&#10007;</span>
                {{end}}
                <span class="timestamp resolve-time">as of {{.ResolveTime.Format "3:04:05 PM"}}</span>
            {{end}}
        </div>
    {{end}}
    {{if ne .Problem ""}}
        <div class="record-problem">{{.Problem | html}}</div>
    {{end}}
    {{if and .ResolveSupported .ResolveChecked (not .ResolveMatches)}}
        <div class="record-resolved-to container">
            <div class="label">Resolves to</div>
            <div class="value monospace resolved-different">{{range $i, $v := .ResolvedValues}}{{if $i}}, {{end}}{{$v | html}}{{else}}nothing{{end}}</div>
        </div>
    {{end}}
    {{if and .ResolveSupported (ne .ResolveError "")}}
        <div class="record-problem">{{if .ResolveChecked}}The last lookup failed{{else}}Not looked up yet, the lookup failed{{end}}: {{.ResolveError | html}}</div>
    {{end}}
    {{if not .LastUpdateTime.IsZero}}
    <div class="dns-record-attributes container">
        <div class="dns-record-ttl container">
            <div class="label">TTL</div>
            <div class="value">{{.Ttl}}</div>
        </div>
        <div class="dns-record-priority container   ">
            <div class="label">Priority</div>
            <div class="value">{{.Priority}}</div>
        </div>
    </div>
    {{end}}
    <div class="last-update-time container">
         <div class="label">Last Updated</div>
         {{if .LastUpdateTime.IsZero}}
            <div class="timestamp">Never</div>
         {{else}}
            <div class="timestamp">{{.LastUpdateTime.Format "2006-01-02 3:04:05 PM"}}</div>
         {{end}}
    </div>
    <div class="last-modified-time container">
         <div class="label">Last Modified</div>
         {{if .LastModifiedTime.IsZero}}
            <div class="timestamp">Never</div>
         {{else}}
            <div class="timestamp">{{.LastModifiedTime.Format "2006-01-02 3:04:05 PM"}}</div>
         {{end}}
    </div>
    <div class="dns-record-stats-gets container">
        <div class="label">Retrievals</div>
        <div class="value">{{.GetSuccessCount | html}} / {{.GetErrorCount | html}}</div>
        <div class="">Success / Failure</div>
    </div>
     <div class="dns-record-stats-updates container">
        <div class="label">Updates</div>
        <div class="value">{{.UpdateSuccessCount | html}} / {{.UpdateErrorCount | html}}</div>
        <div class="">Success / Failure</div>
    </div>
</div>